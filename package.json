{
	"name": "dsh-input-assist",
	"version": "0.1.1",
	"description": "Input assistant for DeepSeek Harness Web UI: inline AI completion (FIM ghost suggestion, Tab to accept) and Chinese-friendly typo checking with click-to-fix.",
	"type": "module",
	"main": "lib/index.js",
	"license": "MIT",
	"author": "honlnk",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/honlnk/dsh-input-assist.git"
	},
	"homepage": "https://honlnk.github.io/dsh-input-assist/",
	"bugs": {
		"url": "https://github.com/honlnk/dsh-input-assist/issues"
	},
	"keywords": [
		"dsh",
		"dsh-plugin",
		"dsh-input-assist",
		"deepseek-harness",
		"deepseek",
		"input-completion",
		"ghost-text",
		"typo-check",
		"chinese",
		"proofreading"
	],
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./client": {
			"default": "./lib/client.js"
		},
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-connection",
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-api-remotes"
			],
			"platform": "web",
			"immediately": true
		}
	},
	"files": [
		"lib/",
		"test/",
		"cordis.patch.yml",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "npm run build && node --test test/*.test.js",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
		"@deepseek-ai/schemastery": "3.18.1"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
		"@types/node": "^26.2.0",
		"@types/react": "^18.3.31",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	}
}
